# Copy this file to .env and fill in real values. Never commit .env.

# Database for predictions and feedback.
# Not set: local SQLite file in data/kiniela.db.
# Production (Neon): the connection string from the Neon dashboard.
# DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/kiniela?sslmode=require

# A/B testing (optional): share of predictions for models/candidate_model.joblib, 0 to 1.
# Not set: every prediction uses the current model. See docs/ab-testing.md.
# AB_CANDIDATE_SHARE=0.5

# Local docker compose only: password of the local PostgreSQL (default: kiniela).
# POSTGRES_PASSWORD=change-me
